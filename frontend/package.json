{
  "name": "ulytech-website",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.17.0",
    "framer-motion": "^10.16.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^7.9.6",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
